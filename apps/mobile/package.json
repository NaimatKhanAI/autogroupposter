{
  "name": "groupposter",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "bridge:start": "tsx --env-file=.env --env-file=.env.bridge scripts/agent-bridge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:backend": "node scripts/test-firebase.mjs firestore",
    "test:db": "node scripts/test-firebase.mjs firestore",
    "functions:build": "npm --prefix functions run build",
    "firebase:deploy": "firebase deploy --project groupposter-1f253 --only firestore",
    "test:auth": "node scripts/test-firebase.mjs auth",
    "test:functions": "node --test tests/backend.integration.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
