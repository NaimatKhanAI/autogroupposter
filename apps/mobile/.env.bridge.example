# Copy to .env.bridge (ignored). These are private server variables, never EXPO_PUBLIC.
GROUPPOSTER_BRIDGE_EMAIL=
GROUPPOSTER_BRIDGE_PASSWORD=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GROUPPOSTER_BRIDGE_TOKEN=
# Workspace Firestore document ID, not the Facebook numeric Page ID.
GROUPPOSTER_BRIDGE_PAGE_ID=
# Explicit active group document IDs, comma-separated; empty means import only.
GROUPPOSTER_BRIDGE_GROUP_IDS=
GROUPPOSTER_BRIDGE_PORT=8787
